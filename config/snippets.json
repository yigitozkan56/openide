    {
      "name": "fetch-async",
      "language": "javascript",
      "prefix": "fetchjson",
      "description": "Async/Await JSON Fetch request",
      "body": [
        "async function fetchData(url) {",
        "  try {",
        "    const response = await fetch(url);",
        "    const data = await response.json();",
        "    console.log(data);",
        "    return data;",
        "  } catch (error) {",
        "    console.error('Fetch error:', error);",
        "  }",
        "}"
      ]
    },
